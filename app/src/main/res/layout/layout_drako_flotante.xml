<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_margin="16dp"
    android:background="@android:color/transparent"
    android:gravity="end"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvGlobo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tarjeta_drako"
        android:maxWidth="240dp"
        android:padding="14dp"
        android:textColor="@color/pv_blanco"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Botón de interacción de Drako para la Caza de Colores -->
    <Button
        android:id="@+id/btnDrakoAccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="¡Buscar Color!"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Imagen de Drako con fondo transparente forzado -->
    <ImageView
        android:id="@+id/imgDrako"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:contentDescription="Drako, toca para escuchar un consejo"
        android:elevation="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/drako" />

</LinearLayout>