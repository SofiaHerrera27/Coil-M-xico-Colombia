<?xml version="1.0" encoding="utf-8"?>
<!-- Karen Fonseca -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_parquevivo">

    <!-- Capa de contraste -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000" />

    <!-- 1. MENÚ PRINCIPAL DEL ÁLBUM -->
    <RelativeLayout
        android:id="@+id/layoutInicioAlbum"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="Álbum de Aventuras"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Tarjeta con instrucciones -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#CCFFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvInstruccionAlbum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="¡Hola, explorador! En este espacio podrás guardar los recuerdos de tus aventuras. Selecciona 'Tomar fotos' para capturar momentos especiales del parque o 'Ver mis fotos' para disfrutar de tu galería personal."
                        android:textColor="#1B4D3E"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón 1: Tomar fotos -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrCamara"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="14dp"
                android:text="Tomar fotos"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#CC1B5E20"
                app:cornerRadius="28dp"
                app:elevation="4dp" />

            <!-- Botón 2: Ver mis fotos -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrGaleria"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="20dp"
                android:text="Ver mis fotos"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#CC1B5E20"
                app:cornerRadius="28dp"
                app:elevation="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Botón Volver -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverInicio"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Volver al menú anterior"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp" />

        </LinearLayout>

        <!-- 1. VISTA DE DRAKO (Se declara primero para que su ID exista) -->
        <ImageView
            android:id="@+id/imgDrakoAlbum"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="70dp"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:src="@drawable/drako" />

        <!-- 2. GLOBO DE TEXTO DE DRAKO (Posicionado sobre imgDrakoAlbum) -->
        <TextView
            android:id="@+id/tvGloboAlbum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/imgDrakoAlbum"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            android:background="@android:color/white"
            android:elevation="6dp"
            android:padding="12dp"
            android:textColor="#333333"
            android:textSize="14sp"
            android:visibility="gone" />

    </RelativeLayout>

    <!-- 2. PANTALLA DE CÁMARA -->
    <LinearLayout
        android:id="@+id/layoutCamara"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewCamara"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#CC000000"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverCamara"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Volver"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:backgroundTint="#555555"
                app:cornerRadius="26dp" />

            <ImageButton
                android:id="@+id/btnCapturar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_boton_captura"
                android:contentDescription="Tomar fotografía"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#1B5E20" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCambiarCamara"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Girar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:backgroundTint="#555555"
                app:cornerRadius="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRepetirFoto"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Repetir"
                android:textAllCaps="false"
                android:visibility="gone"
                app:backgroundTint="#555555"
                app:cornerRadius="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarFoto"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Guardar foto"
                android:textAllCaps="false"
                android:visibility="gone"
                app:backgroundTint="#1B5E20"
                app:cornerRadius="26dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 3. GALERÍA DE FOTOS -->
    <LinearLayout
        android:id="@+id/layoutGaleria"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F7EE"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mis recuerdos"
                android:textColor="#1B4D3E"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverGaleria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volver al álbum"
                android:textAllCaps="false"
                app:backgroundTint="#1B4D3E"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAlbumVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="Aún no tienes fotos guardadas. ¡Captura tu primera aventura!"
            android:textColor="#666666"
            android:textSize="15sp"
            android:visibility="gone" />

        <GridView
            android:id="@+id/gridFotos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:horizontalSpacing="8dp"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:verticalSpacing="8dp" />

    </LinearLayout>

    <!-- 4. VISUALIZAR FOTO AMPLIADA -->
    <LinearLayout
        android:id="@+id/layoutDetalleFoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imageFotoGrande"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eliminar fotografía"
                android:textAllCaps="false"
                app:backgroundTint="#B71C1C"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverDetalle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Volver a mis fotos"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="20dp"
                app:strokeColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>