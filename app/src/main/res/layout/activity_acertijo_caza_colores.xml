<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Vista en vivo de CameraX -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible" />

    <!-- Mira/Retículo en el centro translúcida -->
    <View
        android:id="@+id/viewTargetCenter"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_dialog_redondeado"
        android:backgroundTint="#33FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Texto del Acertijo (Semitransparente con esquinas redondeadas) -->
    <TextView
        android:id="@+id/tvAcertijo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/bg_dialog_redondeado"
        android:backgroundTint="#B31B4332"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panel de Estado flotante y separado -->
    <LinearLayout
        android:id="@+id/layoutEstadoBusqueda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dialog_redondeado"
        android:backgroundTint="#80000000"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvAcertijo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvEstadoEscaneo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Presiona '¡Buscar Color!' para iniciar"
            android:textColor="#E0E0E0"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressBarColor"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Objeto animado (Drako/Mariposa) -->
    <ImageView
        android:id="@+id/imgMariposaPersecucion"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/drako"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Moneda Sorpresa flotante -->
    <ImageView
        android:id="@+id/imgMoneda"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_moneda"
        android:visibility="gone"
        android:elevation="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/viewTargetCenter"
        app:layout_constraintTop_toTopOf="@id/viewTargetCenter"
        android:contentDescription="Moneda Sorpresa" />

    <!-- Panel de Trofeo -->
    <LinearLayout
        android:id="@+id/layoutTrofeo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡TROFEO DESBLOQUEADO!"
            android:textColor="#FFD54F"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgTrofeo"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginVertical="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/drako" />

        <TextView
            android:id="@+id/tvTrofeoNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrofeoPuntos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD54F"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Toca el trofeo para verlo en Premios"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Drako flotante -->
    <include
        android:id="@+id/layout_drako_container"
        layout="@layout/layout_drako_flotante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>