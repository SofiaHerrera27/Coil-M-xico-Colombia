<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Vista en vivo de CameraX con modo compatible para la captura de pantalla -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible" />

    <!-- Mira/Retículo en el centro para indicar dónde enfocar -->
    <View
        android:id="@+id/viewTargetCenter"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_input"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Texto del Acertijo -->
    <TextView
        android:id="@+id/tvAcertijo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#1B4332"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panel de Estado e Indicador de Búsqueda -->
    <LinearLayout
        android:id="@+id/layoutEstadoBusqueda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:background="#1B4332"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvAcertijo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvEstadoEscaneo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Presiona '¡Buscar Color!' para iniciar"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBarColor"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Objeto animado (Drako/Mariposa) a perseguir y atrapar -->
    <ImageView
        android:id="@+id/imgMariposaPersecucion"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/drako"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Drako flotante sobrepuesto en la parte inferior -->
    <include
        android:id="@+id/layout_drako_container"
        layout="@layout/layout_drako_flotante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>