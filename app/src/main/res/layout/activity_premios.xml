<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pv_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis Premios"
            android:textColor="@color/pv_verde_oscuro"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPremiosPuntos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/pv_texto"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvPremiosAvance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pv_texto_suave"
            android:textSize="15sp" />

        <GridLayout
            android:id="@+id/gridTrofeos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="2" />

        <Button
            android:id="@+id/btnVolverPremios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Volver al menú" />
    </LinearLayout>
</ScrollView>