<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F8F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PREMIOS PARQUEVIVO"
            android:textColor="#246B45"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvPuntosDisponibles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tus ParquePuntos: 0"
            android:textColor="#246B45"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catálogo de recompensas"
            android:textColor="#263D30"
            android:textSize="19sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌱 Semilla sorpresa"
                android:textColor="#263D30"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Costo: 50 ParquePuntos"
                android:textColor="#555555"
                android:paddingTop="6dp" />

            <Button
                android:id="@+id/btnCanjearSemilla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simular canje"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🦋 Insignia de explorador"
                android:textColor="#263D30"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Costo: 100 ParquePuntos"
                android:textColor="#555555"
                android:paddingTop="6dp" />

            <Button
                android:id="@+id/btnCanjearInsignia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simular canje"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌳 Guardián de la naturaleza"
                android:textColor="#263D30"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Costo: 200 ParquePuntos"
                android:textColor="#555555"
                android:paddingTop="6dp" />

            <Button
                android:id="@+id/btnCanjearGuardian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simular canje"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResultadoCanje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí aparecerá el resultado de tu canje."
            android:textColor="#246B45"
            android:textSize="16sp"
            android:padding="12dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnVolverPremios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
