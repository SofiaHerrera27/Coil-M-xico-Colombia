<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISOS DE CÁMARA Y HARDWARE -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true"/>
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!-- SERVICIO DE VOZ TTS PARA DRAKO -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParqueVivo">

        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <!-- Pantalla de inicio -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />

        <!-- TU SECCIÓN: Colección 3D de Dragones, Animaciones y Voces TTS -->
        <activity
            android:name=".PremiosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- SECCIÓN DE TU COMPAÑERA: Canje de Puntos y Catálogo -->
        <activity
            android:name=".Premio"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ÁLBUM DE FOTOS / CAPTURAS -->
        <activity
            android:name=".AlbumActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- CAZA DE COLORES -->
        <activity
            android:name=".Acertijo_Caza_Colores"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- VISOR DE REALIDAD AUMENTADA -->
        <activity
            android:name=".ARViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

    </application>

</manifest>